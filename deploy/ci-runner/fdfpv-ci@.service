[Unit]
Description=FDFPV CI: self-hosted runner slot %i
After=network-online.target
Wants=network-online.target
# Never give up: a GitHub outage must not leave the slot dead until someone
# notices. run-slot.sh itself waits a minute after a failed mint.
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/lib/fdfpv-ci/run-slot.sh %i
Restart=always
RestartSec=5
# docker run forwards SIGTERM to the container; give the runner time to
# report a cancelled job before the client is killed.
TimeoutStopSec=60

[Install]
WantedBy=default.target
