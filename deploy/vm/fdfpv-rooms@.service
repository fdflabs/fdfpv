[Unit]
Description=FDFPV rooms server on port %i
After=network.target

[Service]
Type=simple
User=fdfpv-rooms
Group=fdfpv-rooms
# This instance's own copy of the code, made by the deploy that started
# it (rooms-deploy.sh), seen at /opt/fdfpv: the next deploy rewrites
# /opt/fdfpv while this one may still be draining, and the server reads
# some files only when a room first needs them (edge/rooms/war.js
# floorOf), which must be its own version's. Both instances share
# ROOMS_DB; ROOMS_PEER, in the env file, is the other one's address.
BindReadOnlyPaths=/opt/fdfpv-rooms/%i:/opt/fdfpv
WorkingDirectory=/opt/fdfpv
Environment=HOST=127.0.0.1 PORT=%i PUBLIC_ROOMS=on ROOMS_DB=/var/lib/fdfpv-rooms/rooms.db
EnvironmentFile=/etc/fdfpv/rooms-%i.env
# Every seat's session is checked with the tracks server beside this one,
# over loopback, and a seat without one is refused (edge/rooms/node.js
# helloAccount).
Environment=ACCOUNTS_ORIGIN=http://127.0.0.1:8787
EnvironmentFile=/etc/fdfpv/tracks.env
# Voice chat's TURN relay: TURN_SECRET and TURN_URLS, made by
# turn-install.sh (deploy-turn.sh). Optional: without it voice is peer to
# peer through STUN alone (edge/rooms/turn.js).
EnvironmentFile=-/etc/fdfpv/turn.env
EnvironmentFile=-/etc/fdfpv/dev-accounts.env
# node:sqlite is still marked experimental in Node 24 and says so on every
# start; the journal does not need to hear it.
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --max-old-space-size=192 edge/rooms/node.js
# Not always: a drain ends with exit 0, and a drained instance started
# again would be a third version holding stored rooms. A crash still
# restarts it.
Restart=on-failure
RestartSec=1
# SIGTERM closes every socket with 1012 and the process exits in half a
# second; five is the most it may take before systemd kills it.
TimeoutStopSec=5
StateDirectory=fdfpv-rooms
StateDirectoryMode=0700
# Measured 2026-09-28 on this VM (systemctl show -p MemoryPeak): 31 MB with
# 8 pilots flying 3 minutes in one room, 34 MB with 32 pilots in four rooms
# (rooms at 10% of the core, Caddy 6%); ps shows 70 MB RSS, part of it
# the shared Node library the cgroup does not charge. The ceiling is about
# seven times the cgroup peak, for public rooms of 16 and the heap's own
# slack, and V8 is told a heap limit under it so it collects harder
# instead of being killed. Two instances run during a drain: 512M of the
# VM's 5.6 GB at the ceilings.
MemoryMax=256M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
