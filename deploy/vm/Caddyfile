# Caddyfile: the TLS front on the VM, installed as /etc/caddy/Caddyfile by
# deploy/vm/deploy.sh. See deploy/vm/README.md.
#
# The servers answer at two sites with the same routes, the (servers)
# snippet below. api.paraguayandronecombatsimulator.com is the name the
# simulator uses since the game moved to its own domain (src/share/api.js);
# Caddy fetches its certificate once the name's DNS points here. The VM's
# bare address is what the simulator used before, and stays: pages still
# open from before the move, and the page itself while the name's DNS
# spreads, reach it there. Let's Encrypt issues certificates for IP
# addresses on its six day "shortlived" profile, which Caddy renews by
# itself, and an address needs no DNS: the wildcard DNS services that give
# an address a name (sslip.io, nip.io) are on DNS blocklists, and the
# owner's own ISP resolver answers NXDOMAIN for them.
#
# The game's own apex and www are not here: GitHub Pages serves them.
#
# One origin serves all three servers, because their paths never meet: the
# tracks server answers /api/* and the rooms server /v2/* and /, so the
# client's two origins are the same string and each server sees exactly
# the paths it saw as a Worker. The board (fdflabs/fdfpv-leaderboard) is
# mounted at /board/ with the prefix taken off, so it sees the same /api/*
# paths it would at a root of its own, and the page resolves its own
# requests against the directory it was served from.
#
# No access log: connecting addresses are written nowhere (edge/rooms/front.js,
# ADDRESSES). The address is handed to the servers in cf-connecting-ip,
# the header they read on Cloudflare, overwriting whatever a client sent.
#
# This file is part of the Paraguayan Drone Combat Simulator.
#
# The Paraguayan Drone Combat Simulator is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or (at
# your option) any later version.
#
# The Paraguayan Drone Combat Simulator is distributed in the hope that it will be useful, but
# WITHOUT ANY WARRANTY, without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
# General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with the Paraguayan Drone Combat Simulator. If not, see <https://www.gnu.org/licenses/>.

# A client connecting to an address sends no SNI (RFC 6066 forbids an IP
# there), and Caddy picks a certificate by SNI, so without this it has
# none to offer and the handshake fails.
{
	default_sni 129.151.39.48
}

(servers) {
	# Security headers on every answer (docs/SECURITY-HEADERS.md). The
	# servers answer JSON, WebSockets, GIFs and films to the game's own
	# origin; none of it is a page, so the policy forbids everything and
	# nothing here may be framed. The board's pages get their own policy in
	# its handle below, which runs later and so replaces this one.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
	}
	# The board believes X-Forwarded-For under BOARD_TRUST_PROXY, so it is
	# set here to the connecting address rather than appended to whatever a
	# client sent, and the two country headers it would believe are removed:
	# nothing in front of this VM geolocates, so any that arrive are a
	# client's own.
	redir /board /board/ 308
	handle_path /board/* {
		# The board's pages and admin: its own modules, no inline script,
		# inline <style> in the pages, pictures it draws into blob: and
		# data: URLs, and every request to its own origin.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		reverse_proxy 127.0.0.1:3180 {
			header_up X-Forwarded-For {remote_host}
			header_up -Cf-Ipcountry
			header_up -X-Fdfpv-Country
		}
	}

	# Preview videos for the owner (the page is the site's /vids/, served
	# by GitHub Pages; the files are too big for the repository, so they
	# live on this VM in /var/lib/fdfpv-vids, put there by hand, never by a
	# deploy). Only .mp4 files, no directory listing.
	handle_path /vids/* {
		@mp4 path *.mp4
		handle @mp4 {
			root * /var/lib/fdfpv-vids
			header Cache-Control "public, max-age=3600"
			header Access-Control-Allow-Origin "https://paraguayandronecombatsimulator.com"
			file_server
		}
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8787 {
			header_up CF-Connecting-IP {remote_host}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8797 {
			header_up CF-Connecting-IP {remote_host}
		}
	}
}

129.151.39.48 {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	import servers
}

api.paraguayandronecombatsimulator.com {
	import servers
}
