[Unit]
Description=FDFPV tracks server
After=network.target

[Service]
Type=simple
User=fdfpv-tracks
Group=fdfpv-tracks
WorkingDirectory=/opt/fdfpv
Environment=HOST=127.0.0.1 PORT=8787 TRACKS_DB=/var/lib/fdfpv-tracks/tracks.db
# The admin page's server history, written by fdfpv-metrics.service and
# read here read only (tracks-api/metrics.js serverReport). This unit's
# sandbox is unchanged for it: the store's directory is group fdfpv-tracks,
# and the live counters it reads (/proc, the cgroups) every user may read.
Environment=METRICS_DB=/var/lib/fdfpv-metrics/metrics.db
# The optional Google sign-in (tracks-api/accounts.js). The client ids are
# public, a comma separated list (tracks-api/accounts.js parseClientIds),
# new id first: the one src/share/account.js signs in with, then the old
# one a page loaded before this deploy may still hold, so it keeps signing
# in until it is reloaded. Drop the old id once nothing points to it any
# more. ACCOUNTS_SECRET seals the pilot keys accounts carry; deploy.sh
# makes it on the VM the first time, in accounts.env, which only this unit
# reads. Without both a client id and ACCOUNTS_SECRET, the account routes
# answer 503 and nothing else changes.
Environment=GOOGLE_CLIENT_ID=684567545976-dqpf7tqf764rs0dp7l08it7usb33fo9m.apps.googleusercontent.com,533228474420-ij6t37upmahvcg96tava16ild8mdno4t.apps.googleusercontent.com
# The beta is by invite (tracks-api/waitlist.js). Remove to open it.
Environment=INVITE_ONLY=1
EnvironmentFile=/etc/fdfpv/tracks.env
EnvironmentFile=-/etc/fdfpv/accounts.env
# ADMIN_EMAILS=..., the Google accounts the admin page (admin.html) lets
# in. Written on the VM by hand (root, mode 600) and not in the repository,
# which is public. Without it only ADMIN_SECRET opens the admin routes.
EnvironmentFile=-/etc/fdfpv/admin.env
# SMTP_USER and SMTP_PASS, the Gmail address and app password the invite
# emails go out through (tracks-api/node.js smtpSender). Written on the VM
# by hand (root, mode 600). Without it an invite is not emailed.
EnvironmentFile=-/etc/fdfpv/mail.env
# node:sqlite is still marked experimental in Node 24 and says so on every
# start; the journal does not need to hear it.
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --max-old-space-size=192 tracks-api/node.js
Restart=always
RestartSec=1
TimeoutStopSec=5
StateDirectory=fdfpv-tracks
StateDirectoryMode=0700
# Measured 2026-09-28 on this VM (systemctl show -p MemoryPeak): 26 MB
# through tracks-api/smoke.js and the rate limit burst; ps shows 70 MB
# RSS, part of it the shared Node library the cgroup does not charge. A
# save body is at most 520 kB (tracks-api/limits.js), so the ceiling is
# about ten times the cgroup peak, and V8 is told a heap limit under it so
# it collects harder instead of being killed.
MemoryMax=256M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
