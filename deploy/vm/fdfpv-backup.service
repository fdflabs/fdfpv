[Unit]
Description=FDFPV: pull the VM's nightly backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/lib/fdfpv-backup/backup.sh
Nice=10
TimeoutStartSec=15min
