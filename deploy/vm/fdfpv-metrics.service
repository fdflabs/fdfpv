[Unit]
Description=FDFPV metrics: one minute of the VM's history
After=network.target

[Service]
Type=oneshot
User=fdfpv-metrics
Group=fdfpv-tracks
SupplementaryGroups=systemd-journal
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
WorkingDirectory=/opt/fdfpv
Environment=METRICS_DB=/var/lib/fdfpv-metrics/metrics.db
EnvironmentFile=/etc/fdfpv/tracks.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning tracks-api/collect.js
StateDirectory=fdfpv-metrics
StateDirectoryMode=0750
UMask=0027
Nice=10
TimeoutStartSec=30
# Measured 2026-10-05 on the desktop (systemd-run, cgroup memory.peak):
# 29 to 30 MB a run and 0.18 to 0.19 s of CPU, most of that du over a
# 3 GB journal; the VM's journal is 107 MB and node starts there in
# 0.03 s, so a run there should cost no more. Confirm after the first
# deploy with systemctl show -p MemoryPeak,CPUUsageNSec fdfpv-metrics.
# The ceiling is about three times the peak.
MemoryMax=96M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
