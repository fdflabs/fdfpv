[Unit]
Description=FDFPV: off-box monitor of the game and the VM
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=CURL_HOME=%h/.config/fdfpv-monitor/curl-ipv4
ExecStart=%h/.local/lib/fdfpv-monitor/monitor.sh
Nice=10
TimeoutStartSec=3min
