[Unit]
Description=FDFPV board
# Postgres holds every track and time; the board applies its schema.sql at
# start and exits if it cannot, so it starts after the database and goes
# down with it.
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=fdfpv-board
Group=fdfpv-board
WorkingDirectory=/opt/fdfpv-board
# Loopback only: Caddy is the way in, and it sets the forwarded headers
# BOARD_TRUST_PROXY believes. The database is reached over the Unix socket
# with peer authentication as this unit's user, so there is no database
# password anywhere. BOARD_PUBLIC_ORIGIN because a forwarded host cannot
# carry the /board mount's path.
Environment=BOARD_HOST=127.0.0.1 PORT=3180 BOARD_TRUST_PROXY=1
Environment=SIM_ORIGIN=https://fdflabs.github.io/fdfpv BOARD_PUBLIC_ORIGIN=https://129.151.39.48/board
Environment=DATABASE_URL=postgresql:///fdfpvboard?host=/run/postgresql&user=fdfpv-board
EnvironmentFile=/etc/fdfpv/board.env
ExecStart=/usr/bin/node --max-old-space-size=192 src/server.js
Restart=always
RestartSec=1
TimeoutStopSec=5
# Measured 2026-09-29 on this VM (systemctl show -p MemoryPeak): 41 MB
# through scripts/board-live-check.js (a bug, a feel report, a publish, a
# verified lap with its ghost, a live room of two, the board's pages) and
# 400 reads forty at a time; ps shows 107 MB RSS, part of it the shared
# Node library the cgroup does not charge. The ceiling was about six times
# that peak, the same as the other two units, and V8 is told a heap limit
# under it so it collects harder instead of being killed.
#
# Bug reports now carry up to four screenshots, so the largest body the
# board reads is 5.6 MB (it was 660 kB, a publish). Measured again the
# same day after `board-live-check.js --only=paste` and one report at the
# cap and one past it, through Caddy: 72 MB. A report at the cap should
# cost about 20 MB while it is parsed (the bytes, the string, the parsed
# base64, the decoded images; an estimate, not a measurement), so 256M
# still leaves room for several at once and stays where it was.
#
# Postgres has a ceiling of its own, 256M, in the drop-in postgresql.conf
# beside this file, with its measurement.
MemoryMax=256M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
